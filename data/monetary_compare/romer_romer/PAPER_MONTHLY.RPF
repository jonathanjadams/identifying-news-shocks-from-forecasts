* PAPER_MONTHLY.RPF
* 
* RESULTS USING MONTHLY DATA REPORTED IN THE PAPER
*
*####################################################################################
*####################################################################################
*
*                               PART ONE: PRELIMINARIES
*
*####################################################################################
*####################################################################################
*
DISPLAY @3 %DATEANDTIME()
CALENDAR 1946 1 12
*
* NOTE THAT, EXCEPT FOR THE FEDERAL FUNDS RATE, NO DATA AFTER 2016 ARE READ IN
OPEN DATA DATA_MONTHLY.DED
DATA(FORMAT=RATS) 1948:1 2016:12 UR
DATA(FORMAT=RATS) 1948:1 1948:12 URNSA
DATA(FORMAT=RATS) 1946:10 1948:12 LFCENSUSNSA UCENSUSNSA
DATA(FORMAT=RATS) 1954:7 2022:12 FEDFUNDS
DATA(FORMAT=RATS) 1946:10 2016:12 TREAS3MO
*
SMPL 1946:1 2016:12
SET RRDUMMY = 0
COMPUTE RRDUMMY(1947:10) = 1
COMPUTE RRDUMMY(1955:8) = 1
COMPUTE RRDUMMY(1958:9) = 1
COMPUTE RRDUMMY(1968:12) = 1
COMPUTE RRDUMMY(1972:1) = -1
COMPUTE RRDUMMY(1974:4) = 1
COMPUTE RRDUMMY(1978:8) = 1
COMPUTE RRDUMMY(1979:10) = 1
COMPUTE RRDUMMY(1981:5) = 1
COMPUTE RRDUMMY(1988:12) = 1
*
SET RRDUMMYORIG = 0
COMPUTE RRDUMMYORIG(1947:10) = 1
COMPUTE RRDUMMYORIG(1955:9) = 1
COMPUTE RRDUMMYORIG(1968:12) = 1
COMPUTE RRDUMMYORIG(1974:4) = 1
COMPUTE RRDUMMYORIG(1978:8) = 1
COMPUTE RRDUMMYORIG(1979:10) = 1
COMPUTE RRDUMMYORIG(1988:12) = 1
*
SET URCENSUSNSA 1946:10 1948:12 = (UCENSUSNSA/LFCENSUSNSA)*100
SET URCENSUS 1948:1 1948:12 = URCENSUSNSA(T) + (UR(T) - URNSA(T))
SET URCENSUS 1947:1 1947:12 = URCENSUSNSA(T) + (UR(T+12) - URNSA(T+12))
SET URCENSUS 1946:10 1946:12 = URCENSUSNSA(T) + (UR(T+24) - URNSA(T+24))
SET DIFFBLSCEN 1948:1 1948:12 = UR(T) - URCENSUS(T)
STATISTICS(NOPRINT) DIFFBLSCEN 1948:1 1948:12
COMPUTE ADJFACTOR = %MEAN
DISPLAY ADJFACTOR
SET UR 1946:10 1947:12 = URCENSUS + ADJFACTOR
*
SET FEDFUNDS 1946:10 1954:6 = (FEDFUNDS(1954:7) - TREAS3MO(1954:7)) + TREAS3MO(T)
*
* PRINTING SOME THINGS FOR CHECKING
PRINT(DATES) 1946:10 1948:12 LFCENSUSNSA UCENSUSNSA URNSA
PRINT(DATES) 1946:10 1948:12 URCENSUS URCENSUSNSA UR
PRINT(DATES) 1946:1 1955:12 TREAS3MO FEDFUNDS
PRINT(DATES) 2015:1 2022:12 UR FEDFUNDS
*
*####################################################################################
*####################################################################################
*
*                         PART TWO: REGRESSIONS FOR UNEMPLOYMENT
*
*####################################################################################
*####################################################################################
*
* PARAMETERS
*
COMPUTE NSTEP = 60
COMPUTE NLAGSSHOCK = 12
COMPUTE NLAGSOUTCOME = 12
*
SET OUTCOME = UR
*
* BASELINE RESULTS
*
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY ' '
DISPLAY 'FIGURE 1 IN PAPER'
DISPLAY 'ALSO SHOWN IN FIGURE 2'
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.  COEFF.        S. ERROR      T-STAT      OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY HORIZON COEFF SERROR TSTAT '   ' %NOBS
END DO HORIZON
*
* USING OLD SHOCK MEASURE
*
SET SHOCKMEASURE = RRDUMMYORIG
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY ' '
DISPLAY 'SHOWN IN FIGURE 2 IN PAPER'
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.  COEFF.        S. ERROR      T-STAT      OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY HORIZON COEFF SERROR TSTAT '   ' %NOBS
END DO HORIZON
*
*####################################################################################
*####################################################################################
*
*   PART THREE: BEHAVIOR OF FEDERAL FUNDS RATE FOLLOWING THE CONTRACTIONARY SHOCKS
*
*####################################################################################
*####################################################################################
*
DECLARE RECTANGULAR DELTAFF(10,22)
DO HORIZON = -9,12
COMPUTE DELTAFF(10,HORIZON+10) = 0.
END DO HORIZON
*
COMPUTE SHOCKCOUNT = 0
DO TT = 1946:10,2016:12
IF (RRDUMMY(TT).EQ.1)
{
COMPUTE SHOCKCOUNT = SHOCKCOUNT + 1
DO HORIZON = -9,12
COMPUTE DELTAFF(SHOCKCOUNT,HORIZON+10) = FEDFUNDS(TT+HORIZON) - FEDFUNDS(TT-1)
COMPUTE DELTAFF(10,HORIZON+10) = DELTAFF(10,HORIZON+10) $
     + (FEDFUNDS(TT+HORIZON) - FEDFUNDS(TT-1))
END DO HORIZON
DISPLAY SHOCKCOUNT
}
END DO TT
*
DO HORIZON = -9,12
IF (HORIZON.EQ.-9)
{
DISPLAY ' '
DISPLAY $
'HORIZ.   1947:10       1955:8        1958:9        1968:12'
}
DISPLAY HORIZON DELTAFF(1,HORIZON+10) DELTAFF(2,HORIZON+10) DELTAFF(3,HORIZON+10) $
     DELTAFF(4,HORIZON+10)
END DO HORIZON
*
DO HORIZON = -9,12
IF (HORIZON.EQ.-9)
{
DISPLAY ' '
DISPLAY $
'HORIZ.   1974:4        1978:8        1979:10       1981:5        1988:12'
}
DISPLAY HORIZON DELTAFF(5,HORIZON+10) DELTAFF(6,HORIZON+10) DELTAFF(7,HORIZON+10) $
     DELTAFF(8,HORIZON+10) DELTAFF(9,HORIZON+10)
END DO HORIZON
*
* AVERAGE
*
DO HORIZON = -9,12
IF (HORIZON.EQ.-9)
{
DISPLAY ' '
DISPLAY ' '
DISPLAY 'SHOWN IN FIGURE 8 IN PAPER'
DISPLAY ' '
DISPLAY 'HORIZ.  AVERAGE      VS. JUNE 2022'
}
COMPUTE DELTAFF(10,HORIZON+10) = DELTAFF(10,HORIZON+10)/SHOCKCOUNT
COMPUTE RECENT = FEDFUNDS((2022:7) + HORIZON) - FEDFUNDS(2022:6)
DISPLAY HORIZON DELTAFF(10,HORIZON+10) RECENT
END DO HORIZON
*
*************************************************************************************
* END
*************************************************************************************