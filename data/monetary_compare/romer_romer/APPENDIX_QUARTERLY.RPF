DISPLAY '*******************************************************************************'
DISPLAY 'OUTCOME VARIABLE IS GDP PRICE INDEX INFLATION'
DISPLAY '*******************************************************************************'
SET OUTCOMEFULL 1946:1 2019:4 = PCGDPPIFULL
}
SET OUTCOME 1946:1 2016:4 = OUTCOMEFULL
PRINT(DATES) 2016:1 2017:4 OUTCOME OUTCOMEFULL
*
* REDOING THE BASELINE REGRESSION
*
DISPLAY 'REDOING THE BASELINE REGRESSION'
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.  COEFF.        S. ERROR      T-STAT      OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY HORIZON COEFF SERROR TSTAT '   ' %NOBS
END DO HORIZON
* 
* RESIDUALS FROM REGRESSIONS WITHOUT OUR DUMMY
*
DISPLAY ' '
DISPLAY ' '
DISPLAY 'RESIDUALS FROM REGRESSIONS WITHOUT OUR DUMMY'
IF (IOUTCOME.EQ.1)
{
DISPLAY 'THESE 10 SERIES ARE WHAT IS IN FIGURE B4 IN APPENDIX B'
}
IF (IOUTCOME.EQ.2)
{
DISPLAY 'THESE 10 SERIES ARE WHAT IS IN FIGURE B5 IN APPENDIX B'
}
*
*      FIRST FIVE SHOCKS
*
DISPLAY ' '
DISPLAY '     FIRST FIVE SHOCKS'
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY '          1947:4     1955:3         1958:3        1968:4        1972:1'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
DISPLAY HORIZON %RESIDS(1947:4) %RESIDS(1955:3) $
     %RESIDS(1958:3) %RESIDS(1968:4) %RESIDS(1972:1)
END DO HORIZON
*
*      NEXT FIVE SHOCKS
*
DISPLAY ' '
DISPLAY '     NEXT FIVE SHOCKS'
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY '        1974:2        1978:3        1979:4        1981:2        1988:4'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
DISPLAY HORIZON %RESIDS(1974:2) %RESIDS(1978:3) $ 
     %RESIDS(1979:4) %RESIDS(1981:2) %RESIDS(1988:4)
END DO HORIZON
*
END DO IOUTCOME
