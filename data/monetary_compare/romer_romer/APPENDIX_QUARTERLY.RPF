*
* RESIDUALS OF QUARTERLY VARIABLES AFTER ROMER AND ROMER MONETARY SHOCK DATES
*
* LOOPING OVER THE OUTCOME VARIABLES (GDP AND GDP PRICE INFLATION ONLY)
*
DO IOUTCOME = 1,2
DISPLAY ' '
DISPLAY ' '
IF (IOUTCOME.EQ.1)
{
DISPLAY ' '
DISPLAY '*******************************************************************************'
DISPLAY 'OUTCOME VARIABLE IS GDP'
DISPLAY '*******************************************************************************'
SET OUTCOMEFULL 1946:1 2019:4 = LNGDPFULL
}
IF (IOUTCOME.EQ.2)
{
