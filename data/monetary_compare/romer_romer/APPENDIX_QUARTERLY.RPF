* APPENDIX_QUARTERLY.RPF
* 
* RESULTS USING QUARTERLY DATA REPORTED IN APPENDIX B
*
*####################################################################################
*####################################################################################
*
*                               PART ONE: PRELIMINARIES
*
*####################################################################################
*####################################################################################
*
DISPLAY @3 %DATEANDTIME()
CALENDAR 1946 1 4
*
* NOTE THAT NO DATA AFTER 2019 ARE READ IN
OPEN DATA DATA_QUARTERLY.DED
DATA(FORMAT=RATS) 1947:1 2019:4 GDP GDPPI PCEPI PCEPILFE
OPEN DATA DATA_MONTHLY.DED
DATA(FORMAT=RATS,COMPACT=AVERAGE) 1946:4 2019:4 IP
DATA(FORMAT=RATS,COMPACT=AVERAGE) 1946:3 2019:4 CPINSA CPILFESA CPILFSA CPILFNSA
*
SMPL 1946:1 2016:4
SET RRDUMMY = 0
COMPUTE RRDUMMY(1947:4) = 1
COMPUTE RRDUMMY(1955:3) = 1
COMPUTE RRDUMMY(1958:3) = 1
COMPUTE RRDUMMY(1968:4) = 1
COMPUTE RRDUMMY(1972:1) = -1
COMPUTE RRDUMMY(1974:2) = 1
COMPUTE RRDUMMY(1978:3) = 1
COMPUTE RRDUMMY(1979:4) = 1
COMPUTE RRDUMMY(1981:2) = 1
COMPUTE RRDUMMY(1988:4) = 1
*
SMPL 1946:1 2019:4
SET GDP 1946:4 1946:4 = (GDP(1947:1)/IP(1947:1))*IP(T)
SET GDPPI 1946:3 1946:4 = (GDPPI(1947:1)/CPINSA(1947:1))*CPINSA(T)
SET PCEPI 1946:3 1946:4 = (PCEPI(1947:1)/CPINSA(1947:1))*CPINSA(T)
SET PCEPILFE 1957:1 1958:4 = (PCEPILFE(1959:1)/CPILFESA(1959:1))*CPILFESA(T)
SET PCEPILFE 1947:1 1956:4 = (PCEPILFE(1957:1)/CPILFSA(1957:1))*CPILFSA(T)
SET PCEPILFE 1946:3 1946:4 = (PCEPILFE(1947:1)/CPILFNSA(1947:1))*CPILFNSA(T)
*
SET LNGDPFULL = LOG(GDP(T)) * 100.
SET LNGDPPIFULL = LOG(GDPPI(T)) * 100.
SET LNPCEPIFULL = LOG(PCEPI(T)) * 100.
SET LNPCEPILFEFULL = LOG(PCEPILFE(T)) * 100.
*
SET PCGDPPIFULL = 4.*(LNGDPPIFULL(T) - LNGDPPIFULL(T-1))
SET PCPCEPIFULL = 4.*(LNPCEPIFULL(T) - LNPCEPIFULL(T-1))
SET PCPCEPILFEFULL = 4.*(LNPCEPILFEFULL(T) - LNPCEPILFEFULL(T-1))
*
SMPL 1946:1 2016:4
*
* PRINTING SOME THINGS FOR CHECKING
PRINT(DATES) 1946:1 1949:4 IP GDP LNGDPFULL
PRINT(DATES) 1946:1 1949:4 GDPPI PCEPI PCEPILFE
PRINT(DATES) 1946:1 1959:4 PCEPILFE CPILFESA CPILFSA CPILFNSA
PRINT(DATES) 1946:1 1949:4 PCGDPPIFULL PCPCEPIFULL PCPCEPILFEFULL
PRINT(DATES) 2016:1 2019:4 RRDUMMY GDP LNGDPFULL
PRINT(DATES) 2016:1 2019:4 GDPPI PCEPI PCEPILFE
PRINT(DATES) 2016:1 2019:4 PCGDPPIFULL PCPCEPIFULL PCPCEPILFEFULL
*
* PARAMETERS
*
COMPUTE NSTEP = 20
COMPUTE NLAGSOUTCOME = 4
COMPUTE NLAGSSHOCK = 4
COMPUTE NDRAWS = 100000
SEED 5720
COMPUTE NOBSRANGE = 277
DECLARE VECTOR MEANEFFECTS(NSTEP+1) SEEFFECTS(NSTEP+1) NEXCEED(NSTEP+1) $
     BASELINESES(NSTEP+1)
*
*####################################################################################
*####################################################################################
*
*                               PART TWO: MAIN RESULTS
*
*####################################################################################
*####################################################################################
*
* START LOOP OVER THE OUTCOME VARIABLES
*
DO IOUTCOME = 1,4
DISPLAY ' '
DISPLAY ' '
DISPLAY '*******************************************************************************'
IF (IOUTCOME.EQ.1)
{
DISPLAY 'OUTCOME VARIABLE IS GDP'
SET OUTCOMEFULL 1946:1 2019:4 = LNGDPFULL
}
IF (IOUTCOME.EQ.2)
{
DISPLAY 'OUTCOME VARIABLE IS GDP PRICE INDEX INFLATION'
SET OUTCOMEFULL 1946:1 2019:4 = PCGDPPIFULL
}
IF (IOUTCOME.EQ.3)
{
DISPLAY 'OUTCOME VARIABLE IS PCE PRICE INDEX INFLATION'
SET OUTCOMEFULL 1946:1 2019:4 = PCPCEPIFULL
}
IF (IOUTCOME.EQ.4)
{
DISPLAY 'OUTCOME VARIABLE IS CORE PCE PRICE INDEX INFLATION'
SET OUTCOMEFULL 1946:1 2019:4 = PCPCEPILFEFULL
*
}
DISPLAY '*******************************************************************************'
SET OUTCOME 1946:1 2016:4 = OUTCOMEFULL
PRINT(DATES) 2016:1 2017:4 OUTCOME OUTCOMEFULL
*
* GOING THROUGH MOST OF THE VARIOUS SPECIFICATIONS (A FEW OTHERS ARE IN PART THREE)
*
DISPLAY 'REDOING THE BASELINE'
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
COMPUTE BASELINESES(HORIZON+1) = SERROR
IF (HORIZON.EQ.0)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
DISPLAY ' '
DISPLAY 'MAXIMUM: ' MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY 'MINIMUM: ' MINHORIZON *.## MINEFFECT SEMINEFFECT
COMPUTE BASELINEMAX = MAXEFFECT
COMPUTE BASELINEMIN = MINEFFECT
*
DISPLAY ' '
DISPLAY ' '
DISPLAY 'BASELINE -- PRINTING ONE REGRESSION'
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 9,9
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
END DO HORIZON
*
DISPLAY ' '
DISPLAY 'EQUAL NUMBER OF OBSERVATIONS AT EACH HORIZON'
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR 1946:1 2011:4
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
IF (HORIZON.EQ.0)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
DISPLAY ' '
DISPLAY 'MAXIMUM: ' MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY 'MINIMUM: ' MINHORIZON *.## MINEFFECT SEMINEFFECT
*
DISPLAY ' '
DISPLAY ' '
DISPLAY 'USING DATA THROUGH 2019:4'
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOMEFULL(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOMEFULL{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
IF (HORIZON.EQ.0)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
DISPLAY ' '
DISPLAY 'MAXIMUM: ' MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY 'MINIMUM: ' MINHORIZON *.## MINEFFECT SEMINEFFECT
*
DISPLAY ' '
DISPLAY ' '
DISPLAY '8 LAGS'
COMPUTE NLAGSSHOCK = 8
COMPUTE NLAGSOUTCOME = 8
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR 1948:4 2016:4
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
IF (HORIZON.EQ.0)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
DISPLAY ' '
DISPLAY 'MAXIMUM: ' MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY 'MINIMUM: ' MINHORIZON *.## MINEFFECT SEMINEFFECT
COMPUTE NLAGSSHOCK = 4
COMPUTE NLAGSOUTCOME = 4
*
DISPLAY ' '
DISPLAY ' '
DISPLAY '8 LAGS, PRINTING ONE REGRESSION'
COMPUTE NLAGSSHOCK = 8
COMPUTE NLAGSOUTCOME = 8
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 9,9
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG DEPVAR 1948:4 2016:4
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
END DO HORIZON
COMPUTE NLAGSSHOCK = 4
COMPUTE NLAGSOUTCOME = 4
*
DISPLAY ' '
DISPLAY 'BASELINE, BUT STARTING 1948:4 (FOR COMPARISON WITH 8 LAGS)'
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR 1948:4 2016:4
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
IF (HORIZON.EQ.0)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
DISPLAY ' '
DISPLAY 'MAXIMUM: ' MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY 'MINIMUM: ' MINHORIZON *.## MINEFFECT SEMINEFFECT
*
DISPLAY ' '
DISPLAY ' '
DISPLAY 'LEAVING OUT THE CONTEMPORANEOUS EFFECT'
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 1,NSTEP
IF (HORIZON.EQ.1)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{0 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
IF (HORIZON.EQ.1)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
DISPLAY ' '
DISPLAY 'MAXIMUM: ' MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY 'MINIMUM: ' MINHORIZON *.## MINEFFECT SEMINEFFECT
*
* STANDARD ERRORS
*
DISPLAY ' '
DISPLAY ' '
DISPLAY ' '
DISPLAY $
    '       ****************** DIFFERENT WAYS OF DOING STANDARD ERRORS ******************'
DISPLAY ' '
DISPLAY 'ROBUSTERRORS'
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT     SE/BASELN         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT,ROBUSTERRORS) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
COMPUTE SERATIO = SERROR/BASELINESES(HORIZON+1)
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 SERATIO @66 %NOBS
END DO HORIZON
*
DISPLAY ' '
DISPLAY ' '
DISPLAY 'NEWEY-WEST'
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT     SE/BASELN         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT,ROBUSTERRORS,LAGS=HORIZON,LWINDOW=NEWEYWEST) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
COMPUTE SERATIO = SERROR/BASELINESES(HORIZON+1)
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 SERATIO @66 %NOBS
END DO HORIZON
*
DISPLAY ' '
DISPLAY ' '
DISPLAY 'HANSEN-HODRICK (LAG = HORIZON)'
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT     SE/BASELN         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT,ROBUSTERRORS,LAGS=HORIZON) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
COMPUTE SERATIO = SERROR/BASELINESES(HORIZON+1)
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 SERATIO @66 %NOBS
END DO HORIZON
*
DISPLAY ' '
DISPLAY ' '
DISPLAY 'NONPARAMETRIC STANDARD ERRORS'
DO HORIZON = 0,NSTEP
COMPUTE MEANEFFECTS(HORIZON+1) = 0.
COMPUTE SEEFFECTS(HORIZON+1) = 0.
COMPUTE NEXCEED(HORIZON+1) = 0
END DO HORIZON
*
DO IDRAWS = 1, NDRAWS
*
* PARAMETERS AND INITIALZING (FOR THE DRAW)
*
COMPUTE POSCOUNT = 1
COMPUTE NEGCOUNT = 9
COMPUTE NOBSLEFT = NOBSRANGE
*
* DRAWING THE DATES
*
SET MONTECARLODUMMY = 0
DO TT = 1,NOBSRANGE
COMPUTE RANDOMNUMBER = %RANINTEGER(1,NOBSLEFT)
IF ( (RANDOMNUMBER.GT.POSCOUNT) .AND. $
     (RANDOMNUMBER.LE.(NEGCOUNT+POSCOUNT)) )
{
COMPUTE MONTECARLODUMMY((1947:3) + TT) = 1
COMPUTE NEGCOUNT = NEGCOUNT - 1
}
IF (RANDOMNUMBER.LE.POSCOUNT)
{
COMPUTE MONTECARLODUMMY((1947:3) + TT) = -1
COMPUTE POSCOUNT = POSCOUNT - 1
}
*
COMPUTE NOBSLEFT = NOBSLEFT - 1
*
END DO TT
*
* CHECK
*
STATISTICS(NOPRINT) MONTECARLODUMMY
IF ( (%VARIANCE.EQ.0) .OR. (%MEAN.NE.(8./284.)) .OR. (POSCOUNT.NE.0) $
     .OR. (NEGCOUNT.NE.0) )
{
DISPLAY 'ERROR!' IDRAWS POSCOUNT NEGCOUNT %MINIMUM %MAXIMUM %MEAN
HALT
}
*
* RUNNING THE REGRESSIONS
*
DO HORIZON = 0,NSTEP
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# MONTECARLODUMMY{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE MEANEFFECTS(HORIZON+1) = MEANEFFECTS(HORIZON+1) + COEFF
COMPUTE SEEFFECTS(HORIZON+1) = SEEFFECTS(HORIZON+1) + (COEFF**2)
IF (HORIZON.EQ.0)
{
COMPUTE MAXESTIMATE = COEFF
}
IF (COEFF.LT.MAXESTIMATE)
{
COMPUTE MAXESTIMATE = COEFF
}
IF (MAXESTIMATE.LT.BASELINEMAX)
{
COMPUTE NEXCEED(HORIZON+1) = NEXCEED(HORIZON+1) + 1
}
*
END DO HORIZON
*
END DO IDRAWS
*
DO HORIZON = 0,NSTEP
COMPUTE MEANEFFECTS(HORIZON+1) = MEANEFFECTS(HORIZON+1)/NDRAWS
COMPUTE SEEFFECTS(HORIZON+1) = $
     ( (SEEFFECTS(HORIZON+1)/NDRAWS) - (MEANEFFECTS(HORIZON+1)**2) ) **.5
END DO HORIZON
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'HORIZ.   MEAN         ST. DEV.     # EXCEED      SE/BASELN'
}
COMPUTE SERATIO = SEEFFECTS(HORIZON+1)/BASELINESES(HORIZON+1)
DISPLAY HORIZON MEANEFFECTS(HORIZON+1) SEEFFECTS(HORIZON+1) NEXCEED(HORIZON+1) SERATIO
END DO HORIZON
DISPLAY ' '
DISPLAY 'BASELINEMAX: ' BASELINEMAX
*
DISPLAY ' '
DISPLAY @3 %DATEANDTIME()
DISPLAY ' '
*
* END LOOP OVER OUTCOMES
*
END DO IOUTCOME
*
*####################################################################################
*####################################################################################
*
*                     PART THREE: MORE COMPLICATED SPECIFICATIONS
*
*####################################################################################
*####################################################################################
*
* INCLUDING LAGS OF BOTH P AND Y (BASELINE SPECIFICATION ONLY)
*
DO IOUTCOME = 1,4
DISPLAY ' '
DISPLAY ' '
DISPLAY '*******************************************************************************'
IF (IOUTCOME.EQ.1)
{
DISPLAY 'OUTCOME VARIABLE IS GDP'
SET OUTCOMEFULL 1946:1 2019:4 = LNGDPFULL
SET OTHERSERIESFULL 1946:1 2019:4 = PCGDPPIFULL
}
IF (IOUTCOME.EQ.2)
{
DISPLAY 'OUTCOME VARIABLE IS GDP PRICE INDEX INFLATION'
SET OUTCOMEFULL 1946:1 2019:4 = PCGDPPIFULL
SET OTHERSERIESFULL 1946:1 2019:4 = LNGDPFULL
}
IF (IOUTCOME.EQ.3)
{
DISPLAY 'OUTCOME VARIABLE IS PCE PRICE INDEX INFLATION'
SET OUTCOMEFULL 1946:1 2019:4 = PCPCEPIFULL
SET OTHERSERIESFULL 1946:1 2019:4 = LNGDPFULL
}
IF (IOUTCOME.EQ.4)
{
DISPLAY 'OUTCOME VARIABLE IS CORE PCE PRICE INDEX INFLATION'
SET OUTCOMEFULL 1946:1 2019:4 = PCPCEPILFEFULL
SET OTHERSERIESFULL 1946:1 2019:4 = LNGDPFULL
*
}
DISPLAY '*******************************************************************************'
SET OUTCOME 1946:1 2016:4 = OUTCOMEFULL
SET OTHERSERIES 1946:1 2016:4 = OTHERSERIESFULL
PRINT(DATES) 2016:1 2017:4 OUTCOME OUTCOMEFULL OTHERSERIES OTHERSERIESFULL
*
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} OTHERSERIES{1 TO NLAGSOUTCOME} $
     CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
IF (HORIZON.EQ.0)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
DISPLAY ' '
DISPLAY 'MAXIMUM: ' MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY 'MINIMUM: ' MINHORIZON *.## MINEFFECT SEMINEFFECT
*
END DO IOUTCOME
