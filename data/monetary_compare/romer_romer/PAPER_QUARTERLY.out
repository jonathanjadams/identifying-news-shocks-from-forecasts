* PAPER_QUARTERLY.RPF
*
* RESULTS USING QUARTERLY DATA REPORTED IN THE PAPER
*
*####################################################################################
*####################################################################################
*
*                               PART ONE: PRELIMINARIES
*
*####################################################################################
*####################################################################################
*
DISPLAY @3 %DATEANDTIME()
  06/06/2023 11:16
CALENDAR 1946 1 4
*
* NOTE THAT NO DATA AFTER 2016 ARE READ IN
OPEN DATA DATA_QUARTERLY.DED
DATA(FORMAT=RATS) 1947:1 2016:4 GDP GDPPI PCEPI PCEPILFE
OPEN DATA DATA_MONTHLY.DED
DATA(FORMAT=RATS,COMPACT=AVERAGE) 1946:4 2016:4 IP
DATA(FORMAT=RATS,COMPACT=AVERAGE) 1946:3 2016:4 CPINSA CPILFESA CPILFSA CPILFNSA
*
SMPL 1946:1 2016:4
SET RRDUMMY = 0
COMPUTE RRDUMMY(1947:4) = 1
COMPUTE RRDUMMY(1955:3) = 1
COMPUTE RRDUMMY(1958:3) = 1
COMPUTE RRDUMMY(1968:4) = 1
COMPUTE RRDUMMY(1972:1) = -1
COMPUTE RRDUMMY(1974:2) = 1
COMPUTE RRDUMMY(1978:3) = 1
COMPUTE RRDUMMY(1979:4) = 1
COMPUTE RRDUMMY(1981:2) = 1
COMPUTE RRDUMMY(1988:4) = 1
*
SET RRDUMMYORIG = 0
COMPUTE RRDUMMYORIG(1947:4) = 1
COMPUTE RRDUMMYORIG(1955:3) = 1
COMPUTE RRDUMMYORIG(1968:4) = 1
COMPUTE RRDUMMYORIG(1974:2) = 1
COMPUTE RRDUMMYORIG(1978:3) = 1
COMPUTE RRDUMMYORIG(1979:4) = 1
COMPUTE RRDUMMYORIG(1988:4) = 1
*
SET GDP 1946:4 1946:4 = (GDP(1947:1)/IP(1947:1))*IP(T)
SET GDPPI 1946:3 1946:4 = (GDPPI(1947:1)/CPINSA(1947:1))*CPINSA(T)
SET PCEPI 1946:3 1946:4 = (PCEPI(1947:1)/CPINSA(1947:1))*CPINSA(T)
SET PCEPILFE 1957:1 1958:4 = (PCEPILFE(1959:1)/CPILFESA(1959:1))*CPILFESA(T)
SET PCEPILFE 1947:1 1956:4 = (PCEPILFE(1957:1)/CPILFSA(1957:1))*CPILFSA(T)
SET PCEPILFE 1946:3 1946:4 = (PCEPILFE(1947:1)/CPILFNSA(1947:1))*CPILFNSA(T)
*
SET LNGDP = LOG(GDP(T)) * 100.
SET LNGDPPI = LOG(GDPPI(T)) * 100.
SET LNPCEPI = LOG(PCEPI(T)) * 100.
SET LNPCEPILFE = LOG(PCEPILFE(T)) * 100.
*
SET PCGDPPI = 4.*(LNGDPPI(T) - LNGDPPI(T-1))
SET PCPCEPI = 4.*(LNPCEPI(T) - LNPCEPI(T-1))
SET PCPCEPILFE = 4.*(LNPCEPILFE(T) - LNPCEPILFE(T-1))
*
* PRINTING SOME THINGS FOR CHECKING
PRINT(DATES) 1946:1 1949:4 IP GDP LNGDP


 ENTRY          IP              GDP            LNGDP
