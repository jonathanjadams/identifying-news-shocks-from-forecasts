*
*####################################################################################
*####################################################################################
*
*                              PART TWO: REGRESSIONS
*
*####################################################################################
*####################################################################################
*
* PARAMETERS
*
COMPUTE NSTEP = 20
COMPUTE NLAGSSHOCK = 4
COMPUTE NLAGSOUTCOME = 4
*
* START LOOP OVER THE OUTCOME VARIABLES
*
DO IOUTCOME = 1,4
(01.0049) DISPLAY ' '
(01.0066) DISPLAY ' '
(01.0083) DISPLAY '*******************************************************************************'
(01.0119) IF (IOUTCOME.EQ.1)
(02.0141) {
(03.0141) DISPLAY 'OUTCOME VARIABLE IS GDP'
(03.0163) SET OUTCOME = LNGDP
(03.0196) }
(02.0196) IF (IOUTCOME.EQ.2)
(02.0218) {
(03.0218) DISPLAY 'OUTCOME VARIABLE IS GDP PRICE INDEX INFLATION'
(03.0246) SET OUTCOME = PCGDPPI
(03.0280) }
(02.0280) IF (IOUTCOME.EQ.3)
(02.0302) {
(03.0302) DISPLAY 'OUTCOME VARIABLE IS PCE PRICE INDEX INFLATION'
(03.0330) SET OUTCOME = PCPCEPI
(03.0364) }
(02.0364) IF (IOUTCOME.EQ.4)
(02.0386) {
(03.0386) DISPLAY 'OUTCOME VARIABLE IS CORE PCE PRICE INDEX INFLATION'
(03.0415) SET OUTCOME = PCPCEPILFE
(03.0449) }
(02.0449) *
(02.0449) DISPLAY '*******************************************************************************'
(01.0485) *
(01.0485) * BASELINE RESULTS
(01.0485) *
(01.0485) SET SHOCKMEASURE = RRDUMMY
(01.0518) *
(01.0518) IF (IOUTCOME.EQ.1)
(02.0540) {
(03.0540) DISPLAY ' '
(03.0557) DISPLAY ' '
(03.0574) DISPLAY 'FIGURE 3 IN PAPER'
(03.0595) }
(02.0595) IF (IOUTCOME.EQ.2)
(02.0617) {
(03.0617) DISPLAY ' '
(03.0634) DISPLAY ' '
(03.0651) DISPLAY 'FIGURE 5 IN PAPER'
(03.0672) }
(02.0672) IF ((IOUTCOME.EQ.3).OR.(IOUTCOME.EQ.4))
(02.0706) {
(03.0706) DISPLAY ' '
(03.0723) DISPLAY ' '
(03.0740) DISPLAY 'SHOWN IN FIGURE 7 IN PAPER'
(03.0763) }
(02.0763) DO HORIZON = 0,NSTEP
(02.0806) IF (HORIZON.EQ.0)
(03.0828) {
(04.0828) DISPLAY ' '
(04.0845) DISPLAY 'OUTCOME VARIABLE TO SHOCK'
(04.0868) DISPLAY 'HORIZ.  COEFF.        S. ERROR      T-STAT      OBS'
(04.0897) }
(03.0897) SET DEPVAR = OUTCOME(T+HORIZON)
(02.0938) LINREG(NOPRINT) DEPVAR
(02.0956) # SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
(02.1107) COMPUTE COEFF = %BETA(1)
(02.1130) COMPUTE SERROR = %STDERRS(1)
(02.1153) COMPUTE TSTAT = COEFF/SERROR
(02.1180) DISPLAY HORIZON COEFF SERROR TSTAT '   ' %NOBS
(02.1267) END DO HORIZON
(01.1269) *
(01.1269) * REGRESSIONS LEAVING OUT ONE SHOCK AT A TIME
(01.1269) *
(01.1269) IF (IOUTCOME.LE.2)
(02.1291) {
(03.1291) IF (IOUTCOME.EQ.1)
(04.1313) {
(05.1313) DISPLAY ' '
(05.1330) DISPLAY ' '
(05.1347) DISPLAY 'THE 10 "LEAVEOUT"S ARE WHAT IS IN FIGURE 4 IN PAPER'
(05.1376) }
(04.1376) IF (IOUTCOME.EQ.2)
(04.1398) {
(05.1398) DISPLAY ' '
(05.1415) DISPLAY ' '
(05.1432) DISPLAY 'THE 10 "LEAVEOUT"S ARE WHAT IS IN FIGURE 6 IN PAPER'
(05.1461) }
(04.1461) DO LEAVEOUT = 1,10
(04.1502) SET SHOCKMEASURE = RRDUMMY
(04.1536) IF (LEAVEOUT.EQ.1)
(05.1558) COMPUTE SHOCKMEASURE(1947:4) = 0
(05.1583) IF (LEAVEOUT.EQ.2)
(05.1605) COMPUTE SHOCKMEASURE(1955:3) = 0
(05.1630) IF (LEAVEOUT.EQ.3)
(05.1652) COMPUTE SHOCKMEASURE(1958:3) = 0
(05.1677) IF (LEAVEOUT.EQ.4)
(05.1699) COMPUTE SHOCKMEASURE(1968:4) = 0
(05.1724) IF (LEAVEOUT.EQ.5)
(05.1746) COMPUTE SHOCKMEASURE(1972:1) = 0
(05.1771) IF (LEAVEOUT.EQ.6)
(05.1793) COMPUTE SHOCKMEASURE(1974:2) = 0
(05.1818) IF (LEAVEOUT.EQ.7)
(05.1840) COMPUTE SHOCKMEASURE(1978:3) = 0
(05.1865) IF (LEAVEOUT.EQ.8)
(05.1887) COMPUTE SHOCKMEASURE(1979:4) = 0
(05.1912) IF (LEAVEOUT.EQ.9)
(05.1934) COMPUTE SHOCKMEASURE(1981:2) = 0
(05.1959) IF (LEAVEOUT.EQ.10)
(05.1981) COMPUTE SHOCKMEASURE(1988:4) = 0
(05.2006) *
(05.2006) DO HORIZON = 0,NSTEP
(05.2049) IF (HORIZON.EQ.0)
(06.2071) {
(07.2071) DISPLAY ' '
(07.2088) DISPLAY 'LEAVEOUT:' LEAVEOUT
(07.2121) DISPLAY 'OUTCOME VARIABLE TO SHOCK'
(07.2144) DISPLAY 'HORIZ.  COEFF.        S. ERROR      T-STAT      OBS'
(07.2173) }
(06.2173) SET DEPVAR = OUTCOME(T+HORIZON)
(05.2215) LINREG(NOPRINT) DEPVAR
(05.2233) # SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
(05.2384) COMPUTE COEFF = %BETA(1)
(05.2407) COMPUTE SERROR = %STDERRS(1)
(05.2430) COMPUTE TSTAT = COEFF/SERROR
(05.2457) DISPLAY HORIZON COEFF SERROR TSTAT '   ' %NOBS
(05.2544) END DO HORIZON
(04.2546) *
(04.2546) END DO LEAVEOUT
(03.2548) }
(02.2548) END DO IOUTCOME


