* PAPER_QUARTERLY.RPF
* 
* RESULTS USING QUARTERLY DATA REPORTED IN THE PAPER
*
*####################################################################################
*####################################################################################
*
*                               PART ONE: PRELIMINARIES
*
*####################################################################################
*####################################################################################
*
DISPLAY @3 %DATEANDTIME()
CALENDAR 1946 1 4
*
* NOTE THAT NO DATA AFTER 2016 ARE READ IN
OPEN DATA DATA_QUARTERLY.DED
DATA(FORMAT=RATS) 1947:1 2016:4 GDP GDPPI PCEPI PCEPILFE
OPEN DATA DATA_MONTHLY.DED
DATA(FORMAT=RATS,COMPACT=AVERAGE) 1946:4 2016:4 IP
DATA(FORMAT=RATS,COMPACT=AVERAGE) 1946:3 2016:4 CPINSA CPILFESA CPILFSA CPILFNSA
*
SMPL 1946:1 2016:4
SET RRDUMMY = 0
COMPUTE RRDUMMY(1947:4) = 1
COMPUTE RRDUMMY(1955:3) = 1
COMPUTE RRDUMMY(1958:3) = 1
COMPUTE RRDUMMY(1968:4) = 1
COMPUTE RRDUMMY(1972:1) = -1
COMPUTE RRDUMMY(1974:2) = 1
COMPUTE RRDUMMY(1978:3) = 1
COMPUTE RRDUMMY(1979:4) = 1
COMPUTE RRDUMMY(1981:2) = 1
COMPUTE RRDUMMY(1988:4) = 1
*
SET RRDUMMYORIG = 0
COMPUTE RRDUMMYORIG(1947:4) = 1
COMPUTE RRDUMMYORIG(1955:3) = 1
COMPUTE RRDUMMYORIG(1968:4) = 1
COMPUTE RRDUMMYORIG(1974:2) = 1
COMPUTE RRDUMMYORIG(1978:3) = 1
COMPUTE RRDUMMYORIG(1979:4) = 1
COMPUTE RRDUMMYORIG(1988:4) = 1
*
SET GDP 1946:4 1946:4 = (GDP(1947:1)/IP(1947:1))*IP(T)
SET GDPPI 1946:3 1946:4 = (GDPPI(1947:1)/CPINSA(1947:1))*CPINSA(T)
SET PCEPI 1946:3 1946:4 = (PCEPI(1947:1)/CPINSA(1947:1))*CPINSA(T)
SET PCEPILFE 1957:1 1958:4 = (PCEPILFE(1959:1)/CPILFESA(1959:1))*CPILFESA(T)
SET PCEPILFE 1947:1 1956:4 = (PCEPILFE(1957:1)/CPILFSA(1957:1))*CPILFSA(T)
SET PCEPILFE 1946:3 1946:4 = (PCEPILFE(1947:1)/CPILFNSA(1947:1))*CPILFNSA(T)
*
SET LNGDP = LOG(GDP(T)) * 100.
SET LNGDPPI = LOG(GDPPI(T)) * 100.
SET LNPCEPI = LOG(PCEPI(T)) * 100.
SET LNPCEPILFE = LOG(PCEPILFE(T)) * 100.
*
SET PCGDPPI = 4.*(LNGDPPI(T) - LNGDPPI(T-1))
SET PCPCEPI = 4.*(LNPCEPI(T) - LNPCEPI(T-1))
SET PCPCEPILFE = 4.*(LNPCEPILFE(T) - LNPCEPILFE(T-1))
*
* PRINTING SOME THINGS FOR CHECKING
PRINT(DATES) 1946:1 1949:4 IP GDP LNGDP
PRINT(DATES) 1946:1 1949:1 CPINSA GDPPI LNGDPPI PCGDPPI
PRINT(DATES) 1946:1 1949:1 PCEPI LNPCEPI PCPCEPI
PRINT(DATES) 1946:1 1959:4 CPILFESA CPILFSA CPILFNSA PCEPILFE
PRINT(DATES) 1946:1 1959:4 LNPCEPILFE PCPCEPILFE
PRINT(DATES) 1946:1 1949:1 RRDUMMY RRDUMMYORIG
*
*####################################################################################
*####################################################################################
*
*                              PART TWO: REGRESSIONS
*
*####################################################################################
*####################################################################################
*
* PARAMETERS
*
COMPUTE NSTEP = 20
COMPUTE NLAGSSHOCK = 4
COMPUTE NLAGSOUTCOME = 4
*
* START LOOP OVER THE OUTCOME VARIABLES
*
DO IOUTCOME = 1,4
DISPLAY ' '
DISPLAY ' '
DISPLAY '*******************************************************************************'
IF (IOUTCOME.EQ.1)
{
DISPLAY 'OUTCOME VARIABLE IS GDP'
SET OUTCOME = LNGDP
}
IF (IOUTCOME.EQ.2)
{
DISPLAY 'OUTCOME VARIABLE IS GDP PRICE INDEX INFLATION'
SET OUTCOME = PCGDPPI
}
IF (IOUTCOME.EQ.3)
{
DISPLAY 'OUTCOME VARIABLE IS PCE PRICE INDEX INFLATION'
SET OUTCOME = PCPCEPI
}
IF (IOUTCOME.EQ.4)
{
DISPLAY 'OUTCOME VARIABLE IS CORE PCE PRICE INDEX INFLATION'
SET OUTCOME = PCPCEPILFE
}
*
DISPLAY '*******************************************************************************'
*
* BASELINE RESULTS
*
SET SHOCKMEASURE = RRDUMMY
*
IF (IOUTCOME.EQ.1)
{
DISPLAY ' '
DISPLAY ' '
DISPLAY 'FIGURE 3 IN PAPER'
}
IF (IOUTCOME.EQ.2)
{
DISPLAY ' '
DISPLAY ' '
DISPLAY 'FIGURE 5 IN PAPER'
}
IF ((IOUTCOME.EQ.3).OR.(IOUTCOME.EQ.4))
{
DISPLAY ' '
DISPLAY ' '
DISPLAY 'SHOWN IN FIGURE 7 IN PAPER'
}
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.  COEFF.        S. ERROR      T-STAT      OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY HORIZON COEFF SERROR TSTAT '   ' %NOBS
END DO HORIZON
*
* REGRESSIONS LEAVING OUT ONE SHOCK AT A TIME
*
IF (IOUTCOME.LE.2)
{
IF (IOUTCOME.EQ.1)
{
DISPLAY ' '
DISPLAY ' '
DISPLAY 'THE 10 "LEAVEOUT"S ARE WHAT IS IN FIGURE 4 IN PAPER'
}
IF (IOUTCOME.EQ.2)
{
DISPLAY ' '
DISPLAY ' '
DISPLAY 'THE 10 "LEAVEOUT"S ARE WHAT IS IN FIGURE 6 IN PAPER'
}
DO LEAVEOUT = 1,10
SET SHOCKMEASURE = RRDUMMY
IF (LEAVEOUT.EQ.1) 
COMPUTE SHOCKMEASURE(1947:4) = 0
IF (LEAVEOUT.EQ.2) 
COMPUTE SHOCKMEASURE(1955:3) = 0
IF (LEAVEOUT.EQ.3) 
COMPUTE SHOCKMEASURE(1958:3) = 0
IF (LEAVEOUT.EQ.4) 
COMPUTE SHOCKMEASURE(1968:4) = 0
IF (LEAVEOUT.EQ.5) 
COMPUTE SHOCKMEASURE(1972:1) = 0
IF (LEAVEOUT.EQ.6) 
COMPUTE SHOCKMEASURE(1974:2) = 0
IF (LEAVEOUT.EQ.7) 
COMPUTE SHOCKMEASURE(1978:3) = 0
IF (LEAVEOUT.EQ.8) 
COMPUTE SHOCKMEASURE(1979:4) = 0
IF (LEAVEOUT.EQ.9) 
COMPUTE SHOCKMEASURE(1981:2) = 0
IF (LEAVEOUT.EQ.10) 
COMPUTE SHOCKMEASURE(1988:4) = 0
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'LEAVEOUT:' LEAVEOUT
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.  COEFF.        S. ERROR      T-STAT      OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY HORIZON COEFF SERROR TSTAT '   ' %NOBS
END DO HORIZON
*
END DO LEAVEOUT
}
END DO IOUTCOME
*
*************************************************************************************
* END
*************************************************************************************