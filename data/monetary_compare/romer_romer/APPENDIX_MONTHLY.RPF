* APPENDIX_MONTHLY.RPF
* 
* RESULTS USING MONTHLY DATA REPORTED IN APPENDIX B:
*     - BASELINE RESULTS FOR EMP, IP, PCE PRICE INDEX INFL, CORE PCE PRICE INDEX INFL
*     - ROBUSTNESS EXERCISES FOR UNEMPLOYMENT
*
*                               PART ONE: PRELIMINARIES
*
DISPLAY @3 %DATEANDTIME()
CALENDAR 1946 1 12
*
* NOTE THAT NO DATA AFTER 2019 ARE READ IN
* NOTE THAT ONLY DATA READ IN FOR 2017-2019 ARE FOR THE UNEMPLOYMENT RATE
OPEN DATA DATA_MONTHLY.DED
DATA(FORMAT=RATS) 1948:1 2019:12 UR
DATA(FORMAT=RATS) 1946:10 1948:12 LFCENSUSNSA UCENSUSNSA URNSA
DATA(FORMAT=RATS) 1946:10 2016:12 EMP IP
DATA(FORMAT=RATS) 1959:1 2016:12 PCEPI PCEPILFE
DATA(FORMAT=RATS) 1946:9 2016:12 CPINSA CPILFNSA
DATA(FORMAT=RATS) 1947:1 2016:12 CPISA CPILFSA
DATA(FORMAT=RATS) 1957:1 2016:12 CPILFESA
*
SMPL 1946:1 2016:12
SET RRDUMMY = 0
COMPUTE RRDUMMY(1947:10) = 1
COMPUTE RRDUMMY(1955:8) = 1
COMPUTE RRDUMMY(1958:9) = 1
COMPUTE RRDUMMY(1968:12) = 1
COMPUTE RRDUMMY(1972:1) = -1
COMPUTE RRDUMMY(1974:4) = 1
COMPUTE RRDUMMY(1978:8) = 1
COMPUTE RRDUMMY(1979:10) = 1
COMPUTE RRDUMMY(1981:5) = 1
COMPUTE RRDUMMY(1988:12) = 1
*
SET URCENSUSNSA 1946:10 1948:12 = (UCENSUSNSA/LFCENSUSNSA)*100
SET URCENSUS 1948:1 1948:12 = URCENSUSNSA(T) + (UR(T) - URNSA(T))
SET URCENSUS 1947:1 1947:12 = URCENSUSNSA(T) + (UR(T+12) - URNSA(T+12))
SET URCENSUS 1946:10 1946:12 = URCENSUSNSA(T) + (UR(T+24) - URNSA(T+24))
SET DIFFBLSCEN 1948:1 1948:12 = UR(T) - URCENSUS(T)
STATISTICS(NOPRINT) DIFFBLSCEN 1948:1 1948:12
COMPUTE ADJFACTOR = %MEAN
DISPLAY ADJFACTOR
SET UR 1946:10 1947:12 = URCENSUS + ADJFACTOR
SET URFULL 1946:1 2019:12 = UR(T)
SET UR 2017:1 2019:12 = %NA
*
SMPL 1946:1 2016:12
SET PCEPI 1947:1 1958:12 = (PCEPI(1959:1)/CPISA(1959:1))*CPISA(T)
SET PCEPI 1946:9 1946:12 = (PCEPI(1947:1)/CPINSA(1947:1))*CPINSA(T)
SET LNPCEPI 1946:9 2016:12 = LOG(PCEPI(T)) * 100.
*
SET PCEPICORE 1959:1 2016:12 = PCEPILFE(T)
SET PCEPICORE 1957:1 1958:12 = (PCEPICORE(1959:1)/CPILFESA(1959:1))*CPILFESA(T)
SET PCEPICORE 1947:1 1956:12 = (PCEPICORE(1957:1)/CPILFSA(1957:1))*CPILFSA(T)
SET PCEPICORE 1946:9 1946:12 = (PCEPICORE(1947:1)/CPILFNSA(1947:1))*CPILFNSA(T)
SET LNPCEPICORE 1946:9 2016:12 = LOG(PCEPICORE(T)) * 100.
*
SET LNEMP = LOG(EMP(T)) * 100.
SET LNIP = LOG(IP(T)) * 100.
SET PCPCEPI = 12.*(LNPCEPI(T) - LNPCEPI(T-1))
SET PCPCEPICORE = 12.*(LNPCEPICORE(T) - LNPCEPICORE(T-1))
*
* PRINTING SOME THINGS TO CHECK
*
PRINT(DATES) 1946:1 1949:12 UR URFULL
PRINT(DATES) 2016:1 2019:12 UR URFULL
PRINT(DATES) 1946:1 1947:12 LNEMP LNIP
PRINT(DATES) 2016:1 2017:12 LNEMP LNIP
PRINT(DATES) 1946:1 1959:12 PCEPI PCEPICORE PCPCEPI PCPCEPICORE
PRINT(DATES) 2016:1 2017:12 PCPCEPI PCPCEPICORE
*
* PARAMETERS
*
COMPUTE NSTEP = 60
COMPUTE NLAGSOUTCOME = 12
COMPUTE NLAGSSHOCK = 12
COMPUTE NDRAWS = 100000
SEED 71821
COMPUTE NOBSRANGE = 831
DECLARE VECTOR MEANEFFECTS(NSTEP+1) SEEFFECTS(NSTEP+1) NEXCEED(NSTEP+1) $
     BASELINESES(NSTEP+1)
*
*          PART TWO: BASELINE RESULTS FOR ALL VARIABLES OTHER THAN UNEMPLOYMENT
*
DO IOUTCOME = 1,4
DISPLAY ' '
DISPLAY ' '
DISPLAY '*******************************************************************************'
IF (IOUTCOME.EQ.1)
{
DISPLAY 'OUTCOME VARIABLE IS EMPLOYMENT'
SET OUTCOME = LNEMP
}
IF (IOUTCOME.EQ.2)
{
DISPLAY 'OUTCOME VARIABLE IS INDUSTRIAL PRODUCTION'
SET OUTCOME = LNIP
}
IF (IOUTCOME.EQ.3)
{
DISPLAY 'OUTCOME VARIABLE IS PCE PRICE INDEX INFLATION'
SET OUTCOME = PCPCEPI
}
IF (IOUTCOME.EQ.4)
{
DISPLAY 'OUTCOME VARIABLE IS CORE PCE PRICE INDEX INFLATION'
SET OUTCOME = PCPCEPICORE
}
DISPLAY '*******************************************************************************'
*
DISPLAY ' '
SET SHOCKMEASURE = RRDUMMY
*
IF (IOUTCOME.EQ.1)
{
DISPLAY ' '
DISPLAY 'FIGURE B1 IN APPENDIX B'
}
IF (IOUTCOME.EQ.2)
{
DISPLAY ' '
DISPLAY 'FIGURE B2 IN APPENDIX B'
}
IF ((IOUTCOME.EQ.3).OR.(IOUTCOME.EQ.4))
{
DISPLAY ' '
DISPLAY 'SHOWN IN FIGURE B3 IN APPENDIX B'
}
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.  COEFF.        S. ERROR      T-STAT      OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY HORIZON COEFF SERROR TSTAT '   ' %NOBS
END DO HORIZON
END DO IOUTCOME
*
*                          PART THREE: ROBUSTNESS RESULTS FOR UNEMPLOYMENT
*
* NOTE THAT UNEMPLOYMENT RISES AFTER OUR SHOCKS, SO THE INTERPRETATION OF MAXEFFECT
* AND MINEFFECT ARE REVERSED FROM THOSE FOR THE OUTCOME MEASURES IN OUR OTHER PROGRAMS.
*
SET OUTCOMEFULL 1946:1 2019:12 = URFULL
SET OUTCOME 1946:1 2016:12 = OUTCOMEFULL
PRINT(DATES) 2016:1 2017:12 OUTCOME OUTCOMEFULL
*
*
* REDOING THE BASELINE
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
COMPUTE BASELINESES(HORIZON+1) = SERROR
IF (HORIZON.EQ.0)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
*
DISPLAY MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY MINHORIZON *.## MINEFFECT SEMINEFFECT
COMPUTE BASELINEMAX = MAXEFFECT
COMPUTE BASELINEMIN = MINEFFECT
DISPLAY BASELINEMAX BASELINEMIN
*
*
* BASELINE -- PRINTING ONE REGRESSION
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 27,27
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
END DO HORIZON
*
*
* EQUAL NUMBER OF OBSERVATIONS AT EACH HORIZON
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR 1946:1 2011:12
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
IF (HORIZON.EQ.0)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
*
DISPLAY MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY MINHORIZON *.## MINEFFECT SEMINEFFECT
*
*
* USING DATA THROUGH 2019:12
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOMEFULL(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOMEFULL{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
IF (HORIZON.EQ.0)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
*
DISPLAY MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY MINHORIZON *.## MINEFFECT SEMINEFFECT
*
*
* 24 LAGS
COMPUTE NLAGSSHOCK = 24
COMPUTE NLAGSOUTCOME = 24
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR 1948:10 2016:12
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
IF (HORIZON.EQ.0)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
*
DISPLAY MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY MINHORIZON *.## MINEFFECT SEMINEFFECT
COMPUTE NLAGSSHOCK = 12
COMPUTE NLAGSOUTCOME = 12
*
*
* 24 LAGS, PRINTING ONE REGRESSION
COMPUTE NLAGSSHOCK = 24
COMPUTE NLAGSOUTCOME = 24
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 27,27
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG DEPVAR 1948:10 2016:12
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
END DO HORIZON
COMPUTE NLAGSSHOCK = 12
COMPUTE NLAGSOUTCOME = 12
*
*
* BASELINE, BUT STARTING 1948:10 (FOR COMPARISON WITH 24 LAGS)
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR 1948:10 2016:12
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
IF (HORIZON.EQ.0)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
*
DISPLAY MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY MINHORIZON *.## MINEFFECT SEMINEFFECT
*
*
* LEAVING OUT THE CONTEMPORANEOUS EFFECT
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 1,NSTEP
IF (HORIZON.EQ.1)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{0 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 %NOBS
IF (HORIZON.EQ.1)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINEFFECT = COEFF
COMPUTE MINHORIZON = HORIZON
}
IF (COEFF.LT.MAXEFFECT)
{
COMPUTE MAXEFFECT = COEFF
COMPUTE SEMAXEFFECT = SERROR
COMPUTE MAXHORIZON = HORIZON
}
IF (COEFF.GT.MINEFFECT)
{
COMPUTE MINEFFECT = COEFF
COMPUTE SEMINEFFECT = SERROR
COMPUTE MINHORIZON = HORIZON
}
END DO HORIZON
*
DISPLAY MAXHORIZON *.## MAXEFFECT SEMAXEFFECT
DISPLAY MINHORIZON *.## MINEFFECT SEMINEFFECT
*
*
****************** DIFFERENT WAYS OF DOING STANDARD ERRORS ******************
*
*
* ROBUSTERRORS
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT     SE/BASELN         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT,ROBUSTERRORS) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
COMPUTE SERATIO = SERROR/BASELINESES(HORIZON+1)
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 SERATIO @66 %NOBS
END DO HORIZON
*
*
* NEWEY-WEST
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT     SE/BASELN         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT,ROBUSTERRORS,LAGS=HORIZON,LWINDOW=NEWEYWEST) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
COMPUTE SERATIO = SERROR/BASELINESES(HORIZON+1)
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 SERATIO @66 %NOBS
END DO HORIZON
*
*
* HANSEN-HODRICK (LAG = HORIZON)
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.    COEFF.      S. ERROR      T-STAT     SE/BASELN         OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT,ROBUSTERRORS,LAGS=HORIZON) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
COMPUTE SERATIO = SERROR/BASELINESES(HORIZON+1)
DISPLAY *.## @3 HORIZON @11 COEFF @25 SERROR @38 TSTAT @52 SERATIO @66 %NOBS
END DO HORIZON
*
*
* NONPARAMETRIC STANDARD ERRORS
DO HORIZON = 0,NSTEP
COMPUTE MEANEFFECTS(HORIZON+1) = 0.
COMPUTE SEEFFECTS(HORIZON+1) = 0.
COMPUTE NEXCEED(HORIZON+1) = 0
END DO HORIZON
*
DO IDRAWS = 1, NDRAWS
*
* PARAMETERS AND INITIALZING (FOR THE DRAW)
*
COMPUTE POSCOUNT = 1
COMPUTE NEGCOUNT = 9
COMPUTE NOBSLEFT = NOBSRANGE
*
* DRAWING THE DATES
*
SET MONTECARLODUMMY = 0
DO TT = 1,NOBSRANGE
COMPUTE RANDOMNUMBER = %RANINTEGER(1,NOBSLEFT)
IF ( (RANDOMNUMBER.GT.POSCOUNT) .AND. $
     (RANDOMNUMBER.LE.(NEGCOUNT+POSCOUNT)) )
{
COMPUTE MONTECARLODUMMY((1947:9) + TT) = 1
COMPUTE NEGCOUNT = NEGCOUNT - 1
}
IF (RANDOMNUMBER.LE.POSCOUNT)
{
COMPUTE MONTECARLODUMMY((1947:9) + TT) = -1
COMPUTE POSCOUNT = POSCOUNT - 1
}
*
COMPUTE NOBSLEFT = NOBSLEFT - 1
*
END DO TT
*
* CHECK
*
STATISTICS(NOPRINT) MONTECARLODUMMY
IF ( (%VARIANCE.EQ.0) .OR. (%MEAN.NE.(8./852.)) .OR. (POSCOUNT.NE.0) $
     .OR. (NEGCOUNT.NE.0) )
{
DISPLAY 'ERROR!' IDRAWS POSCOUNT NEGCOUNT %MINIMUM %MAXIMUM %MEAN
HALT
}
*
* RUNNING THE REGRESSIONS
*
DO HORIZON = 0,NSTEP
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# MONTECARLODUMMY{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE MEANEFFECTS(HORIZON+1) = MEANEFFECTS(HORIZON+1) + COEFF
COMPUTE SEEFFECTS(HORIZON+1) = SEEFFECTS(HORIZON+1) + (COEFF**2)
IF (HORIZON.EQ.0)
{
COMPUTE MINESTIMATE = COEFF
}
IF (COEFF.GT.MINESTIMATE)
{
COMPUTE MINESTIMATE = COEFF
}
IF (MINESTIMATE.GT.BASELINEMIN)
{
COMPUTE NEXCEED(HORIZON+1) = NEXCEED(HORIZON+1) + 1
}
*
END DO HORIZON
*
END DO IDRAWS
*
DO HORIZON = 0,NSTEP
COMPUTE MEANEFFECTS(HORIZON+1) = MEANEFFECTS(HORIZON+1)/NDRAWS
COMPUTE SEEFFECTS(HORIZON+1) = $
     ( (SEEFFECTS(HORIZON+1)/NDRAWS) - (MEANEFFECTS(HORIZON+1)**2) ) **.5
END DO HORIZON
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'HORIZ.   MEAN         ST. DEV.     # EXCEED      SE/BASELN'
}
COMPUTE SERATIO = SEEFFECTS(HORIZON+1)/BASELINESES(HORIZON+1)
DISPLAY HORIZON MEANEFFECTS(HORIZON+1) SEEFFECTS(HORIZON+1) NEXCEED(HORIZON+1) SERATIO
END DO HORIZON
DISPLAY BASELINEMIN
*
*   PART FOUR: FORECAST ERRORS AND REGRESSIONS LEAVING OUT ONE SHOCK AT A TIME
*
* UNEMPLOYMENT RATE RESIDUALS AFTER ROMER AND ROMER MONETARY SHOCK DATES
*
* REDOING THE BASELINE REGRESSION
*
SET SHOCKMEASURE = RRDUMMY
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'OUTCOME VARIABLE TO SHOCK'
DISPLAY 'HORIZ.  COEFF.        S. ERROR      T-STAT      OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
END DO HORIZON
* 
* RESIDUALS FROM REGRESSIONS WITHOUT OUR DUMMY
*
*
* THESE 10 SERIES ARE WHAT IS IN FIGURE B6 IN APPENDIX B
*
*      FIRST FIVE SHOCKS
*
DISPLAY ' '
DISPLAY '     FIRST FIVE SHOCKS'
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY '       1947:10      1955:8         1958:9       1968:12         1972:1'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
DISPLAY HORIZON %RESIDS(1947:10) %RESIDS(1955:8) %RESIDS(1958:9) %RESIDS(1968:12) %RESIDS(1972:1)
END DO HORIZON
*
*      NEXT FIVE SHOCKS
*
DISPLAY ' '
DISPLAY '     NEXT FIVE SHOCKS'
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY '        1974:4        1978:8       1979:10        1981:5       1988:12'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
DISPLAY HORIZON %RESIDS(1974:4) %RESIDS(1978:8) $ 
     %RESIDS(1979:10) %RESIDS(1981:5) %RESIDS(1988:12)
END DO HORIZON
*
* REGRESSIONS LEAVING OUT ONE SHOCK AT A TIME
*
DO LEAVEOUT = 1,10
SET SHOCKMEASURE = RRDUMMY
IF (LEAVEOUT.EQ.1) 
{
DISPLAY ' '
DISPLAY ' '
DISPLAY 'THE 10 "LEAVEOUT"S ARE WHAT IS IN FIGURE B7 IN APPENDIX B'
COMPUTE SHOCKMEASURE(1947:10) = 0
}
IF (LEAVEOUT.EQ.2) 
COMPUTE SHOCKMEASURE(1955:8) = 0
IF (LEAVEOUT.EQ.3) 
COMPUTE SHOCKMEASURE(1958:9) = 0
IF (LEAVEOUT.EQ.4) 
COMPUTE SHOCKMEASURE(1968:12) = 0
IF (LEAVEOUT.EQ.5) 
COMPUTE SHOCKMEASURE(1972:1) = 0
IF (LEAVEOUT.EQ.6) 
COMPUTE SHOCKMEASURE(1974:4) = 0
IF (LEAVEOUT.EQ.7) 
COMPUTE SHOCKMEASURE(1978:8) = 0
IF (LEAVEOUT.EQ.8) 
COMPUTE SHOCKMEASURE(1979:10) = 0
IF (LEAVEOUT.EQ.9) 
COMPUTE SHOCKMEASURE(1981:5) = 0
IF (LEAVEOUT.EQ.10) 
COMPUTE SHOCKMEASURE(1988:12) = 0
*
DO HORIZON = 0,NSTEP
IF (HORIZON.EQ.0)
{
DISPLAY ' '
DISPLAY 'LEAVEOUT:' LEAVEOUT
DISPLAY 'UNEMPLOYMENT RATE TO SHOCK'
DISPLAY 'HORIZ.  COEFF.        S. ERROR      T-STAT      OBS'
}
SET DEPVAR = OUTCOME(T+HORIZON)
LINREG(NOPRINT) DEPVAR
# SHOCKMEASURE{0 TO NLAGSSHOCK} OUTCOME{1 TO NLAGSOUTCOME} CONSTANT
COMPUTE COEFF = %BETA(1)
COMPUTE SERROR = %STDERRS(1)
COMPUTE TSTAT = COEFF/SERROR
DISPLAY HORIZON COEFF SERROR TSTAT '   ' %NOBS
END DO HORIZON
*
END DO LEAVEOUT
*
*************************************************************************************
* END
*************************************************************************************